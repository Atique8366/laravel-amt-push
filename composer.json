{
    "name": "biometric-push/laravel-adms",
    "description": "ZKTeco ADMS / PUSH (iclock) server for Laravel 8-12+: devices connect to your app over HTTP, punches, users, commands and fingerprint/face templates are stored and managed from PHP, artisan or an optional REST API.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "zkteco",
        "adms",
        "push",
        "iclock",
        "biometric",
        "attendance",
        "fingerprint",
        "face"
    ],
    "require": {
        "php": "^7.4|^8.0",
        "ext-json": "*",
        "ext-mbstring": "*",
        "illuminate/bus": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/console": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/database": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/events": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/http": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/queue": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/routing": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^9.5|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "BiometricPush\\Adms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BiometricPush\\Adms\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BiometricPush\\Adms\\AdmsServiceProvider"
            ],
            "aliases": {
                "Adms": "BiometricPush\\Adms\\Facades\\Adms"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
